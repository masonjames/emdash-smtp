{
  "name": "emdash-smtp-marketplace",
  "version": "0.4.0",
  "description": "Marketplace-safe SMTP and transactional email plugin for EmDash",
  "type": "module",
  "main": "dist/compat/index.mjs",
  "types": "dist/compat/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/compat/index.d.mts",
      "default": "./dist/compat/index.mjs"
    },
    "./sandbox": "./dist/plugin.mjs"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.d.mts",
    "dist/manifest.json",
    "dist/compat",
    "emdash-plugin.jsonc",
    "README.md",
    "CHANGELOG.md",
    "icon.png",
    "screenshots"
  ],
  "scripts": {
    "build": "emdash-plugin build && tsdown src/index.ts --out-dir dist/compat --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "marketplace",
    "smtp",
    "email"
  ],
  "author": "Mason James",
  "dependencies": {
    "emdash-smtp-core": "0.4.0"
  },
  "peerDependencies": {
    "emdash": ">=1.0.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "plugin": {
    "id": "emdash-smtp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masonjames/emdash-smtp.git",
    "directory": "packages/emdash-smtp-marketplace"
  },
  "homepage": "https://github.com/masonjames/emdash-smtp#readme",
  "bugs": {
    "url": "https://github.com/masonjames/emdash-smtp/issues"
  }
}
